# Docentric Copilot — environment template
#
# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is git-ignored. The API loads it automatically at startup; real
# environment variables always win over values from the file.
# `mock` is always available and needs no key — the offline baseline.

# ---------------------------------------------------------------------------
# 1. LLM KEYS  ← put your AI keys here
# ---------------------------------------------------------------------------
# Leave a key empty to keep that provider disabled. The API reports what is
# actually configured at GET /api/v1/providers.
# Never commit real keys; rotate by editing `.env` and restarting the API.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: restrict the model or the catalogue offered in the UI.
DC_OPENAI_MODEL=gpt-6-sol
DC_OPENAI_MODELS=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
DC_ANTHROPIC_MODEL=claude-sonnet-5-5
DC_ANTHROPIC_MODELS=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY or GOOGLE_API_KEY; the first non-empty one is used.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Verified with a live plan on 2026-11-03. gemini-3-flash-preview also works
# after the adapter drops unsupported schema keywords, but its free tier cap
# (20 requests/day) blocked verification; raise the model deliberately.
DC_GEMINI_MODEL=gemini-3.1-flash-lite
DC_GEMINI_MODELS=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------
# 2. Generation guardrails (apply to every provider)
# ---------------------------------------------------------------------------
DC_LLM_TIMEOUT_SECONDS=60
DC_LLM_MAX_RETRIES=2
DC_LLM_MAX_GENERATION_COST_USD=0.50
DC_LLM_MAX_OUTPUT_TOKENS=8000

# ---------------------------------------------------------------------------
# 3. Application
# ---------------------------------------------------------------------------
DC_ENV=development
DC_DATA_DIR=.data
DC_ARTIFACT_TTL_SECONDS=3600
# Sanitized auto-routing traces (no prompt text, no keys). Git-ignored.
DC_ROUTING_TRACE_DIR=docs/media/runs
DC_LOG_LEVEL=INFO
DC_LOG_JSON=true

# Browser origins allowed to call the API. With the Next.js proxy the browser
# only talks to port 3000, so this mainly matters for direct API clients.
DC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# 4. Input limits
# ---------------------------------------------------------------------------
DC_MAX_DDSP_BYTES=10485760
DC_MAX_UNCOMPRESSED_BYTES=67108864
DC_MAX_COMPRESSION_RATIO=120
DC_MAX_ZIP_ENTRIES=512
DC_MAX_XML_NODES=250000
DC_MAX_XML_DEPTH=64
DC_MAX_SCHEMA_NODES=5000
DC_MAX_IR_BLOCKS=5000
DC_MAX_IR_DEPTH=24
DC_MAX_TEXT_LENGTH=20000

# ---------------------------------------------------------------------------
# 5. Docentric AX
# ---------------------------------------------------------------------------
# Keep this false. AX compatibility is not verified; enabling the experimental
# adapter never turns output into a verified Docentric template.
DC_ENABLE_AX_ADAPTER=false
