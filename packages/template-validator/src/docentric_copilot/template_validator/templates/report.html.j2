<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Validation report · Docentric Copilot</title>
<style>
  :root { color-scheme: light; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
         margin: 0; padding: 32px; color: #111827; background: #f8fafc; }
  main { max-width: 960px; margin: 0 auto; background: #fff; border: 1px solid #e5e7eb;
         border-radius: 12px; padding: 32px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .muted { color: #6b7280; font-size: 13px; }
  .banner { margin: 20px 0; padding: 12px 16px; border-radius: 8px; font-size: 14px;
            border: 1px solid #fcd34d; background: #fffbeb; color: #78350f; }
  .banner.ok { border-color: #86efac; background: #f0fdf4; color: #14532d; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 14px; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #e5e7eb;
           vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #6b7280; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px;
           font-weight: 600; }
  .passed { background: #dcfce7; color: #166534; }
  .failed { background: #fee2e2; color: #991b1b; }
  .warning { background: #fef3c7; color: #92400e; }
  .skipped, .not_tested { background: #e5e7eb; color: #374151; }
  code { background: #f3f4f6; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
  ul { margin: 8px 0 0; padding-left: 18px; }
  li { margin: 4px 0; font-size: 13px; }
</style>
</head>
<body>
<main>
  <h1>Validation report</h1>
  <p class="muted">
    Target: <strong>{{ report.target }}</strong> ·
    Schema: <strong>{{ report.schema_id or "unknown" }}</strong> ·
    IR digest: <code>{{ report.ir_digest[:16] }}</code> ·
    Checks: {{ counts.checks }} · Errors: {{ counts.errors }} · Warnings: {{ counts.warnings }}
  </p>

  {% if report.statuses().docentric_compatibility == "not_tested" %}
  <div class="banner">
    <strong>Docentric AX compatibility: not tested.</strong>
    The generated document is a generic DOCX. Compatibility with Docentric AX is
    unverified and must not be claimed until an independent test in a licensed
    environment succeeds.
  </div>
  {% else %}
  <div class="banner ok">Compatibility status: {{ report.statuses().docentric_compatibility }}</div>
  {% endif %}

  <table>
    <thead>
      <tr><th>Level</th><th>Status</th><th>Checks</th></tr>
    </thead>
    <tbody>
      {% for level, status in report.statuses().items() %}
      <tr>
        <td>{{ level.replace("_", " ").title() }}</td>
        <td><span class="badge {{ status }}">{{ status }}</span></td>
        <td>
          <ul>
          {% for check in report.checks if check.level.value == ("compatibility" if level == "docentric_compatibility" else level) %}
            <li>
              <strong>{{ check.name }}</strong>
              <span class="badge {{ check.status.value }}">{{ check.status.value }}</span>
              — {{ check.summary }}
              {% if check.findings %}
              <ul>
                {% for finding in check.findings %}
                <li><code>{{ finding.code }}</code> {{ finding.message }}
                  {% if finding.location %} <em>({{ finding.location }})</em>{% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </li>
          {% endfor %}
          </ul>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="muted" style="margin-top:24px">
    Generated by Docentric Copilot · deterministic validation engine · V1–V3 autonomous,
    V4 renderer dependent, V5 requires a licensed Docentric environment.
  </p>
</main>
</body>
</html>
